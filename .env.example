# Required. Every API call must send: Authorization: Bearer <API_BEARER_TOKEN>
API_BEARER_TOKEN=change-me

# Optional
# API_PORT=8080                 # host port for the APIs and Swagger
# RESEED_ON_START=false         # true = regenerate all mock data on every start
# AUTH_MODE=static              # static: the token above; okta: Okta access tokens; both: either
# OKTA_ISSUER=https://<your-org>.okta.com/oauth2/default
# OKTA_AUDIENCE=api://default
